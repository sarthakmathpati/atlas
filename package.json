{
  "name": "atlas",
  "private": true,
  "version": "0.1.0",
  "description": "Atlas: a personal study map for cracking SDE and quant interviews.",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "npm run build:data && vite",
    "build:syllabus": "node scripts/build-syllabus.mjs",
    "build:layout": "node scripts/build-layout.mjs",
    "build:data": "npm run build:syllabus && npm run build:layout",
    "build": "npm run build:data && vite build",
    "build:artifact": "npm run build:data && vite build --config vite.artifact.config.ts && node scripts/check-artifact.mjs",
    "release:artifact": "npm run build:artifact && node scripts/release-artifact.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build && npm run build:artifact"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-sans-condensed": "5.3.0",
    "date-fns": "4.4.0",
    "dexie": "4.4.6",
    "lucide-react": "1.48.0",
    "nanoid": "6.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "d3-contour": "4.0.2",
    "d3-force": "3.0.0",
    "d3-polygon": "3.0.1",
    "d3-shape": "3.2.0",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "fake-indexeddb": "6.2.5",
    "fflate": "0.8.3",
    "globals": "17.12.0",
    "jsdom": "30.1.1",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.0",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "5.0.1"
  }
}
